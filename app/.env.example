# Banco Neon (Dashboard do Neon > Connection string, modo "pooled")
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Gere com: openssl rand -base64 32
AUTH_SECRET=
# Chave para criptografar tokens do WhatsApp/Meta (openssl rand -base64 32)
ENCRYPTION_KEY=
# Protege as rotas /api/cron/*
CRON_SECRET=
# Integrações Meta (WhatsApp Cloud API e Ads)
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Primeiro acesso master (usado pelo npm run db:seed)
MASTER_EMAIL=
MASTER_PASSWORD=
